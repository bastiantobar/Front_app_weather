<resources>
    <style name="BottomNavTextActive" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="BottomNavTextInactive" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="PollutantLabel" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="PollutantValue" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>
</resources>
